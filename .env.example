# URL base de la API REST de e-commerce (Laravel 12, repo joscal06/swaggerapi), incluyendo /api.
# Solo se usa en el servidor (Server Components, Server Actions); el navegador nunca la llama.
API_BASE_URL=http://127.0.0.1:8000/api

# Llave PUBLICABLE de Stripe en modo de prueba (pk_test_...). Debe pertenecer a la misma cuenta
# que STRIPE_SECRET en el .env de la API. Nunca pongas aquí la llave secreta (sk_...).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# URL pública de este frontend (canonical y Open Graph). En local: http://localhost:3000
SITE_URL=http://localhost:3000
